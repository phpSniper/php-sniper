{
    "name": "phpsniper/sniper",
    "description": "A lightweight, secure, and fluent PHP database toolkit. Simplify your database interactions with an elegant query builder.",
    "keywords": ["database", "query-builder", "pdo", "mysql", "sqlite", "orm", "php"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/phpSniper/php-sniper",
    "authors": [
        {
            "name": "Suraj",
            "role": "Creator"
        }
    ],
    "support": {
        "issues": "https://github.com/phpSniper/php-sniper/issues",
        "source": "https://github.com/phpSniper/php-sniper"
    },
    "require": {
        "php": "^8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Sniper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sniper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
